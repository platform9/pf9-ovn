#!/bin/sh
# prerm script for ovn-host
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <prerm> `remove'
#        * <old-prerm> `upgrade' <new-version>
#        * <new-prerm> `failed-upgrade' <old-version>
#        * <conflictor's-prerm> `remove' `in-favour' <package> <new-version>
#        * <deconfigured's-prerm> `deconfigure' `in-favour'
#          <package-being-installed> <version> `removing' <conflicting-package>
#          <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    remove|deconfigure)
        # ovn-host.service stops ovn-controller with --restart, which
        # deliberately preserves this chassis' state in the southbound DB so
        # that upgrades do not disturb the data plane.  When the package is
        # actually going away that state would be left behind as garbage, so
        # stop once without --restart to run the full cleanup: delete the
        # Chassis/Chassis_Private rows and clear the chassis and encap
        # columns on our Port_Bindings - that's what binding_cleanup()/
        # chassis_cleanup() (controller/binding.c, controller/chassis.c) do
        # as part of ovn-controller's own non-restart exit path.
        #
        # That only works if there's a live ovn-controller process to signal:
        # stop_ovn_daemon() (ovn-lib.in) just finds no pidfile and returns
        # success when the controller is already stopped - crashed, manually
        # stopped, boot without the service enabled, Restart=on-failure
        # exhausted, etc. - silently skipping the real cleanup instead of
        # failing loudly. If the controller is already down, do the same
        # southbound-DB cleanup directly instead of relying on it. This is
        # reachable without a running ovn-controller: external_ids:ovn-remote
        # is a local proxy (pf9-comms on this host, confirmed via `ss -tlnp`)
        # independent of ovn-controller's own process, and
        # external_ids:system-id is exactly Chassis.name (both tables are
        # uniquely indexed on name in ovn-sb.ovsschema, so this can never
        # match more than the one row for this chassis).
        if systemctl is-active --quiet ovn-host 2>/dev/null; then
            if [ -x /usr/share/ovn/scripts/ovn-ctl ]; then
                /usr/share/ovn/scripts/ovn-ctl --no-monitor stop_controller || true
            fi
        else
            remote=$(ovs-vsctl get Open_vSwitch . external_ids:ovn-remote 2>/dev/null | tr -d '"') || remote=
            chassis_name=$(ovs-vsctl get Open_vSwitch . external_ids:system-id 2>/dev/null | tr -d '"') || chassis_name=
            if [ -n "$remote" ] && [ -n "$chassis_name" ]; then
                chassis_uuid=$(ovn-sbctl --db="$remote" --if-exists get Chassis "$chassis_name" _uuid 2>/dev/null) || chassis_uuid=
                if [ -n "$chassis_uuid" ]; then
                    for pb in $(ovn-sbctl --db="$remote" --bare --columns=_uuid \
                                find Port_Binding "chassis=$chassis_uuid" 2>/dev/null); do
                        ovn-sbctl --db="$remote" clear Port_Binding "$pb" chassis 2>/dev/null || true
                        ovn-sbctl --db="$remote" clear Port_Binding "$pb" encap 2>/dev/null || true
                    done
                    ovn-sbctl --db="$remote" --if-exists destroy Chassis_Private "$chassis_name" 2>/dev/null || true
                    ovn-sbctl --db="$remote" --if-exists destroy Chassis "$chassis_name" 2>/dev/null || true
                fi
            else
                echo "ovn-host.prerm: WARNING: ovn-controller was already" \
                     "stopped and ovn-remote/system-id could not be read -" \
                     "this chassis' Port_Binding/Chassis state in the" \
                     "southbound DB was NOT cleaned up and will need to be" \
                     "removed manually." >&2
            fi
        fi
        ;;

    upgrade|failed-upgrade)
        # Nothing to do: the graceful stop/start is handled by the service.
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
